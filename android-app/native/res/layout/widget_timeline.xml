<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tl_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tl_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:text="Water plan" android:textColor="#40513B" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/tl_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#526247" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/tl_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:background="@drawable/widget_chip" android:paddingLeft="9dp" android:paddingRight="9dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#40513B" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/tl_strip" android:layout_width="match_parent" android:layout_height="30dp"
        android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="Water timeline" />
    <LinearLayout android:id="@+id/tl_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tl_a" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#526247" android:textSize="11sp" />
        <TextView android:id="@+id/tl_b" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#526247" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:minHeight="40dp" android:orientation="horizontal">
        <TextView android:id="@+id/tl_drink" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"
            android:layout_marginRight="6dp" android:background="@drawable/widget_btn" android:gravity="center"
            android:text="Drank it" android:textColor="#FDF8E3" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tl_p100" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginRight="6dp" android:background="@drawable/widget_btn2" android:gravity="center"
            android:text="+100" android:textColor="#40513B" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tl_p250" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_btn2" android:gravity="center"
            android:text="+250" android:textColor="#40513B" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
