<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingLeft="12dp" android:paddingRight="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/q_info" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:minWidth="64dp" android:orientation="vertical" android:paddingRight="6dp">
        <TextView android:id="@+id/q_ml" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#40513B" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/q_goal" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="of 2,500" android:textColor="#526247" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/q_100" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="4dp"
        android:background="@drawable/widget_btn2" android:gravity="center" android:minHeight="40dp" android:text="+100" android:textColor="#40513B" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/q_200" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="4dp"
        android:background="@drawable/widget_btn2" android:gravity="center" android:minHeight="40dp" android:text="+200" android:textColor="#40513B" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/q_250" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="4dp"
        android:background="@drawable/widget_btn" android:gravity="center" android:minHeight="40dp" android:text="+250" android:textColor="#FDF8E3" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/q_500" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="4dp"
        android:background="@drawable/widget_btn2" android:gravity="center" android:minHeight="40dp" android:text="+500" android:textColor="#40513B" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
